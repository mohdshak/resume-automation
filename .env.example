# ResumeTailor AI - Environment Configuration

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas Dashboard -> Connect -> Drivers -> Node.js
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/resumetailor_ai?retryWrites=true&w=majority
MONGODB_URI=

# Next.js API Base URL (default is /api/v1 for serverless routing)
NEXT_PUBLIC_API_URL=/api/v1
